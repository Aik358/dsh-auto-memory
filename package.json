{
  "name": "@a9i5k4/dsh-auto-memory",
  "description": "Minimal DSH memory: automatic extraction, consolidation, short summaries, on-demand search, correction/deletion, and source tracing.",
  "version": "4.0.0-alpha.1",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "icon.svg",
    "cordis.patch.yml",
    "README.zh-CN.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "memory",
    "plugin",
    "auto-memory"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidLi17/dsh-auto-memory.git"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "license": "BSD-3-Clause",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node --check lib/index.js && node --check lib/client.js && npm test"
  }
}
