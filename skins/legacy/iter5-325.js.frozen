        if (action === 'repair' && !window.confirm(L('确认仅重建以下文件的索引副本（正文不变）？', 'Rebuild index copies for these files? Source text is unchanged.') + '\n' + (payload.items || []).map(function (s) { return s.file || s.sourceRef }).join('\n'))) return
