              } else {
                var pyReady2 = (det && det.pythonInt8Present !== undefined) ? det.pythonInt8Present : sem.pythonInt8Present
                pyState = (pyReady2 === undefined || pyReady2 === null) ? L('状态未知', 'unknown') : (pyReady2 ? '✓ 就绪' : '✗ 未就绪')
              }
