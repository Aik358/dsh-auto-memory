          ' · ' + (L('覆盖 ', 'overwrites ')) + String((migPlan.overwrites || []).length) +
          ' · ' + (L('将写入 ', 'will write ')) + String((migPlan.stats && migPlan.stats.willWrite) || 0) +
          ' · ' + (L('重写命中 ', 'rewrite hits ')) + String((migPlan.rewrite && migPlan.rewrite.totalHits) || 0) +
