                if (pr.state === 'verified-ok') {
                  pyState = L('✓ 就绪（已实测启动）', '✓ Ready (verified)')
                  pyHint = (pr.chosenLabel || '') + (pr.chosenIsDev ? L(' · 检测到开发值，欢迎开发者', ' · dev tree detected') : '')
