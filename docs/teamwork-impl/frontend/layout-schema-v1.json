  "authorSurface": {
    "reorder": {
      "label": "改顺序",
      "how": "[data-dam-region] 覆写 order，或父容器 display:flex|grid + grid-template-areas；slot 级用 [data-dam-slot=\"Y\"] { order: N }",
      "source": "28 卷 §3.1 ① / §3.5 方式 A·B"
    },
    "resize": {
      "label": "改尺寸",
      "how": "覆写 --dam-region-w / --dam-region-h / --dam-region-min",
      "source": "28 卷 §3.1 ②"
    },
    "visibility": {
      "label": "显隐",
      "how": "[data-dam-region=\"X\"] { display:none } / [data-dam-slot=\"Y\"] { display:none }",
      "source": "28 卷 §3.1 ③"
    },
    "aesthetics": {
      "label": "改块外观",
      "how": "覆写 --dam-* token；块级用 [data-dam-block][data-dam-kind=\"Z\"]；换块外观可选消费 --dam-block-style（唯一需我方预留的消费点，28 卷 §3.5 方式 C）",
      "source": "28 卷 §3.1 ④ / §3.5 方式 C"
    },
    "imagery": {
      "label": "改图片与背景图 banner",
      "how": "块图片 [data-dam-block][data-dam-kind=\"media|empty\"] background-image；帧级背景图 banner 走同族 token/属性，禁远程 URL、禁 @import",
      "source": "28 卷 §3.4 media/empty + §3.6 authorSurface.imagery"
    }
  }
