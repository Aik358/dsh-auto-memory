{
  "$schema": "dam-l2-layout/v1",
  "version": 1,
  "regions": [
    {
      "name": "page",
      "part": "page",
      "order": 10,
      "desc": "会话页整页承载面。28 卷 §3.2 R1：owner=auto-memory 的自定裸值；实测锚点 data-dam-page（anchors.json #1）。"
    },
    {
      "name": "float",
      "part": "am-panel",
      "order": 20,
      "desc": "浮层面板（左下角记忆浮窗）。官方 part `panel` 已被 pet / session-id / model-capabilities 三 owner 占用，按 37 卷 §3.2 定案自造裸值 am-panel，不扩大撞名面；实测锚点 data-dam-panel（anchors.json #2）。"
    },
    {
      "name": "page-nav",
      "part": "tab-bar",
      "order": 30,
      "desc": "会话页左侧固定导航 / 浮层顶部横向条。官方 part `tab-bar`（owner=ssh / skill-explorer），选择器须叠加 [data-dsh-plugin=\"auto-memory\"]；实测锚点 data-dam-page-nav（#6）、data-dam-nav-item（#155）。"
    },
    {
      "name": "settings",
      "part": "settings",
      "order": 40,
      "desc": "设置页整体。28 卷 §3.6 原样取用 `settings`；该值在 semantic-attrs 中属 data-dsh-surface 组（owner=shell）而非 part 组，锚定时须与 [role=\"dialog\"] 组合判定区分；实测锚点 data-dam-settings-nav（#20）、data-dam-settings-content（#21）。"
    },
    {
      "name": "dialog",
      "part": "dialog",
      "order": 50,
      "desc": "弹窗宿主（更新弹窗 / 首启向导 / 工作台弹窗）。官方 part `dialog`（owner=git-graph）；实测锚点 data-dam-tour（#53）、data-dam-tour-backdrop（#52）。"
    },
    {
      "name": "sidebar-entry",
      "part": "sidebar-entry",
      "order": 60,
      "desc": "侧栏入口按钮。官方 part `sidebar-entry`（owner=family）；实测锚点 data-dam-sidebar-btn（#0）。"
    },
    {
      "name": "overlay",
      "part": "overlay",
      "order": 70,
      "desc": "帧级浮层（auto-continue 宿主）。28 卷 §3.2 R7 / §3.6：owner=auto-memory 的自定裸值；同名值亦见于官方 data-dsh-surface 组（owner=shell），故须 data-dsh-plugin=\"auto-memory\" 限定；实测锚点 data-dam-autocont（#158）。"
    }
  ],
