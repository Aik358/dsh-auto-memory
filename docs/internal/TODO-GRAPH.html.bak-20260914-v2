  *{box-sizing:border-box}
  body{margin:0;background:var(--paper);color:var(--ink);
    font:14px/1.6 "Segoe UI","PingFang SC","Microsoft YaHei",system-ui,sans-serif;}
  header{position:sticky;top:0;z-index:20;background:color-mix(in srgb,var(--paper) 88%,transparent);
    backdrop-filter:blur(10px);border-bottom:1px solid var(--line);padding:14px 22px 12px}
  h1{margin:0 0 2px;font-size:17px;letter-spacing:.2px}
  h1 span{color:var(--accent)}
  .sub{color:var(--muted);font-size:12px}
  .bar{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-top:10px}
  .chip{border:1px solid var(--line);background:var(--card);color:var(--ink);border-radius:999px;
    padding:3px 11px;font-size:12px;cursor:pointer}
  .chip[data-on="1"]{border-color:var(--ink);background:var(--ink);color:var(--paper)}
  .btn{border:1px solid var(--line);background:var(--card);color:var(--ink);border-radius:8px;
    padding:4px 10px;font-size:12px;cursor:pointer}
  .btn:hover{border-color:var(--accent);color:var(--accent)}
  .legend{display:flex;gap:14px;flex-wrap:wrap;margin-top:8px;font-size:12px;color:var(--muted)}
  .dot{display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:5px;vertical-align:1px}
  main{max-width:1180px;margin:0 auto;padding:22px 22px 80px}
  .phase{position:relative;margin:0 0 10px;padding-left:30px}
  .phase::before{content:"";position:absolute;left:9px;top:34px;bottom:-14px;width:2px;background:var(--line)}
  .phase:last-child::before{display:none}
  .phead{display:flex;align-items:center;gap:10px;margin:26px 0 12px;position:relative}
  .phead::before{content:"";position:absolute;left:-26px;top:50%;transform:translateY(-50%);
    width:12px;height:12px;border-radius:50%;background:var(--paper);border:2px solid var(--muted)}
  .phase[data-tone="decide"] .phead::before{border-color:var(--decide)}
  .phase[data-tone="p0"] .phead::before{border-color:var(--p0)}
  .phase[data-tone="p1"] .phead::before{border-color:var(--p1)}
  .phase[data-tone="p2"] .phead::before{border-color:var(--p2)}
  .phase[data-tone="inbox"] .phead::before{border-color:var(--inbox)}
  .phead h2{margin:0;font-size:15px}
  .phead .hint{color:var(--muted);font-size:12px}
  .cards{display:flex;flex-direction:column;gap:12px}
  .card{background:var(--card);border:1px solid var(--line);border-left:3px solid var(--muted);
    border-radius:12px;padding:12px 14px;box-shadow:var(--shadow);position:relative}
  .card[data-tone="decide"]{border-left-color:var(--decide)}
  .card[data-tone="p0"]{border-left-color:var(--p0)}
  .card[data-tone="p1"]{border-left-color:var(--p1)}
  .card[data-tone="p2"]{border-left-color:var(--p2)}
  .card[data-tone="defer"]{border-left-color:var(--defer);opacity:.72}
  .card[data-added="1"]{border-left-color:var(--inbox);background:var(--card2)}
  .card .row1{display:flex;flex-wrap:wrap;gap:8px;align-items:baseline}
  .lvl{font-weight:700;font-size:12px;color:var(--accent);letter-spacing:.4px}
  .title{font-weight:600;font-size:14px}
  .tag{font-size:11px;border:1px solid var(--line);border-radius:999px;padding:1px 8px;color:var(--muted)}
  .tag.st{background:color-mix(in srgb,var(--p0) 10%,transparent);border-color:transparent;color:var(--p0)}
  .tag.dep{background:color-mix(in srgb,var(--p2) 12%,transparent);border-color:transparent;color:var(--p2)}
  .kill{position:absolute;right:8px;top:8px;border:0;background:transparent;color:var(--muted);
    cursor:pointer;font-size:14px;line-height:1}
  .kill:hover{color:var(--accent)}
  ul.pts{margin:8px 0 0;padding-left:18px}
  ul.pts li{margin:2px 0}
  .crit{margin-top:8px;padding:8px 10px;border-radius:8px;background:var(--card2);border:1px dashed var(--line)}
  .crit b{font-size:12px;color:var(--muted);font-weight:600}
  .refs{margin-top:8px;font-size:12px;color:var(--muted)}
  .refs code{background:var(--card2);border:1px solid var(--line);border-radius:5px;padding:0 4px}
  .slot{border:1px dashed var(--line);border-radius:12px;padding:12px 14px;color:var(--muted);
    background:transparent;display:flex;justify-content:space-between;align-items:center;gap:10px}
