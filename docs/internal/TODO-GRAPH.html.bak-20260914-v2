  .addbtn{border:1px dashed var(--line);background:transparent;color:var(--muted);border-radius:10px;
    padding:8px;font-size:12.5px;cursor:pointer}
  .addbtn:hover{border-color:var(--inbox);color:var(--inbox)}
  .note{border:1px solid var(--line);background:var(--card);border-radius:12px;padding:12px 14px;margin-top:14px;font-size:12.5px;color:var(--muted)}
  .note b{color:var(--ink)}
