  }
  @media (prefers-color-scheme: dark){
    :root{ --paper:#141416; --ink:#EDEBE7; --muted:#9C9CA4; --line:#2C2C31; --card:#1C1C20; --card2:#222227; --shadow:0 1px 2px rgba(0,0,0,.4),0 8px 24px rgba(0,0,0,.35); }
