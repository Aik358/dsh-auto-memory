      { id:"P2-10", phase:"p2", lvl:"P2-⑩", title:"SCF 云函数 zip 重部署", who:"你", status:"待你操作",
        points:["新 index.zip 已重打（含 ?report=N 路由与版本标记）","上传后在群里或 ?diag=1 核对"] },

      { id:"P2-11", phase:"p2", lvl:"P2-⑪", title:"日历换开源方案（自研太粗糙）", who:"执行方调研 + 你定夺", status:"待调研", est:"调研约半天",
        points:["群反馈第 7 条：「日历插件太粗糙，需要搜索公开的开源日历插件，直接替换掉我写的这个草台班子」",
                "调研面：DSH 生态现成日历插件 ／ 通用开源日历组件，比较「替换成本 vs 自研补齐」",
                "注意迁移：日历数据现在落在 ~/.dsh/memory/CALENDAR.md（本插件自己维护的 md），换组件要给出旧数据导入路径"],
        crit:["给出 2~3 个候选（含许可与维护活跃度）+ 一个推荐","旧数据迁移路径明确（能一条命令导过去）"] },

      { id:"P2-12", phase:"p2", lvl:"P2-⑫", title:"手机端远程控制：首次启动指引太大且关不掉", who:"执行方", status:"远期（随 UI 调整）",
        points:["群反馈第 6 条：手机端远程控制首次启动指引过大、且无法关闭",
                "与「明确推后」阶段的冷启动余项同源（welcomeTourEnabled 死键 / 向导无兜底触发），<b>合并做</b>"],
        crit:["小屏下指引可关闭，且关闭状态被记住"] },

      { id:"A-1", phase:"defer", title:"大排期三件套（界面 / 文档 / 首页）", who:"你", status:"推后",
        points:["需 6 个拍板点 + 3 样输入（官方 DSH 网页 URL·截图 / 角色基准图 / 风格探针许可）"] },
      { id:"A-2", phase:"defer", title:"界面技术债：令牌层 / 组件层 / i18n / IA 重排", status:"推后",
        points:["硬编码色 320 处 / 内联 style 228 vs className 4 / :focus 0 条 / 12 页签塞进 440×560"] },
      { id:"A-3", phase:"defer", title:"文档体系：README 大改 / USER-GUIDE / 双语对账 / 27 张配图", status:"推后" },
      { id:"A-4", phase:"defer", title:"分发门面：npm 瘦身 / package.json 字段 / Pages / CHANGELOG 死链", status:"推后" },
      { id:"A-5", phase:"defer", title:"冷启动余项：向导兜底触发 / 幻觉 ON / 引擎步重试 / welcomeTourEnabled / 术语 Top5", status:"推后" }
    ]
  };

  var state = load();
  var filter = "all";

  function load(){
    try{ var raw = localStorage.getItem(KEY); if(!raw) return {added:[],hidden:[]};
      var o = JSON.parse(raw);
      return { added: Array.isArray(o.added)?o.added:[], hidden: Array.isArray(o.hidden)?o.hidden:[] };
    }catch(e){ return {added:[],hidden:[]} }
  }
  function save(){ try{ localStorage.setItem(KEY, JSON.stringify(state)) }catch(e){} }

  function tone(id){ var p = DATA.phases.filter(function(x){return x.id===id})[0]; return p?p.tone:"inbox" }
  function visible(it){
    if(state.hidden.indexOf(it.id)>=0) return false;
    if(filter==="all") return true;
    if(filter==="main") return it.phase==="p0" || it.phase==="p1";
    if(filter==="core") return it.phase==="p0" || it.phase==="p1" || it.phase==="graph";
    return it.phase===filter;
  }
  function esc(s){ return String(s==null?"":s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;") }

  function card(it){
    var t = tone(it.phase) === "inbox" ? "p2" : tone(it.phase);
    var h = '<div class="card" data-tone="' + (it.added?"inbox":t) + '" data-added="' + (it.added?1:0) + '">';
    h += '<button class="kill" title="隐藏这条" data-kill="' + esc(it.id) + '">×</button>';
    h += '<div class="row1">';
    if(it.lvl) h += '<span class="lvl">' + esc(it.lvl) + '</span>';
    h += '<span class="title">' + esc(it.title) + '</span>';
    if(it.status) h += '<span class="tag st">' + esc(it.status) + '</span>';
    if(it.who) h += '<span class="tag">' + esc(it.who) + '</span>';
    if(it.est) h += '<span class="tag">' + esc(it.est) + '</span>';
    (it.deps||[]).forEach(function(d){ h += '<span class="tag dep">依赖 ' + esc(d) + '</span>' });
    if(it.added) h += '<span class="tag">我加的</span>';
    h += '</div>';
    if(it.points && it.points.length){
      h += '<ul class="pts">';
      it.points.forEach(function(p){ h += '<li>' + p + '</li>' });   // 允许内联小标签
      h += '</ul>';
    }
    if(it.note) h += '<div class="refs">↳ ' + esc(it.note) + '</div>';
    if(it.crit && it.crit.length){
      h += '<div class="crit"><b>验收判据（打钩用）</b><ul class="pts">';
      it.crit.forEach(function(c){ h += '<li>' + esc(c) + '</li>' });
      h += '</ul></div>';
    }
    if(it.refs && it.refs.length){
      h += '<div class="refs">参考：';
      it.refs.forEach(function(r){ h += '<code>' + esc(r) + '</code> ' });
      h += '</div>';
    }
    return h + '</div>';
  }

  function render(){
    var all = DATA.items.concat(state.added);
    var out = '';
    DATA.phases.forEach(function(ph){
      var list = all.filter(function(it){ return it.phase===ph.id && visible(it) });
      var slots = (ph.id==="inbox");
      var showPhase = (filter==="all") || (filter==="main" ? (ph.id==="p0" || ph.id==="p1") : filter==="core" ? (ph.id==="p0" || ph.id==="p1" || ph.id==="graph") : (filter===ph.id)) || slots;
      if(!showPhase) return;
      if(!list.length && !slots) return;
      out += '<section class="phase" data-tone="' + ph.tone + '">';
      out += '<div class="phead"><h2>' + esc(ph.title) + '</h2>';
      if(ph.hint) out += '<span class="hint">' + esc(ph.hint) + '</span>';
      out += '</div><div class="cards">';
      list.forEach(function(it){ out += card(it) });
      if(slots){
        for(var i=0;i<6;i++){
          out += '<div class="slot"><span>空位 ' + (i+1) + ' · 等一条新待办（群反馈 / ZCode 待办 / 你想到的）</span>' +
                 '<button class="btn" data-add="' + ph.id + '">＋ 加一条</button></div>';
        }
      }
      out += '</div></section>';
    });
    document.getElementById("mount").innerHTML = out;
    document.getElementById("sub").textContent =
      "数据源：MASTER-PLAN-3.0.md（总纲 v2）+ MERGE-CONFLICT-SCAN + ROUND3-REVIEW-INTEGRATION + WB-GRAPH 三份 + TODO-BACKLOG §0/§K/§L（更新 " + DATA.updated + "）· "
      + "v2 开工顺序：P0 与白板最小适配边界 → P6A → P1 与 P6B → P2 → P3 → P4 → P5 · 白板线独立推进 · 虚线框是留给你加待办的空位";
  }

  function addItem(phaseId){
    var title = prompt("新待办标题（例：群里反馈的「XX 面板不刷新」）");
    if(!title) return;
    state.added.push({ id:"NEW-" + Date.now(), phase:phaseId, title:title.trim(),
      who:"你", status:"待排期", added:true, points:["（占位：细节待你补充，或我按群反馈整理）"] });
    save(); render();
  }

  document.addEventListener("click", function(e){
    var k = e.target.closest("[data-kill]");
    if(k){ state.hidden.push(k.getAttribute("data-kill")); save(); render(); return }
    var a = e.target.closest("[data-add]");
    if(a){ addItem(a.getAttribute("data-add")); return }
    var f = e.target.closest("[data-filter]");
    if(f){
      filter = f.getAttribute("data-filter");
      [].forEach.call(document.querySelectorAll("[data-filter]"), function(b){ b.setAttribute("data-on", b===f ? "1":"0") });
      render();
    }
  });

  document.getElementById("exportBtn").addEventListener("click", function(){
    var payload = { updated:new Date().toISOString().slice(0,10), added:state.added, hidden:state.hidden };
    var txt = JSON.stringify(payload, null, 2);
    var ta = document.getElementById("io");
    ta.style.display = "block"; ta.value = txt;
    try{ ta.select(); document.execCommand("copy") }catch(e){}
    alert("已生成并尝试复制到剪贴板——把这整段贴给我即可。");
  });

  document.getElementById("resetBtn").addEventListener("click", function(){
    if(!confirm("清空你加的待办与隐藏记录？（不动我原来写的内容）")) return;
    state = {added:[],hidden:[]}; save(); render();
  });

  render();
})();
</script>
</body>
</html>
